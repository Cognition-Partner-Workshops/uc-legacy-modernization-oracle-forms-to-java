@page "/tickets"
@rendermode InteractiveServer
@inject SupportApiClient ApiClient

<PageTitle>Tickets - Support Agent</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><span class="bi bi-ticket-detailed me-2"></span>Support Tickets</h2>
        <button class="btn btn-outline-primary" @onclick="LoadTickets" disabled="@_isLoading">
            <span class="bi bi-arrow-clockwise me-1"></span> Refresh
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading tickets...</p>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger">
            <span class="bi bi-exclamation-triangle me-2"></span>
            @_errorMessage
        </div>
    }
    else if (_tickets.Count == 0)
    {
        <div class="text-center py-5">
            <span class="bi bi-inbox display-1 text-muted"></span>
            <p class="mt-3 text-muted fs-5">No tickets found</p>
            <a href="/chat" class="btn btn-primary">Chat with Support to Create One</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in _tickets)
                    {
                        <tr>
                            <td><code>@ticket.Id</code></td>
                            <td>
                                <strong>@ticket.Title</strong>
                                <br />
                                <small class="text-muted">@ticket.CustomerEmail</small>
                            </td>
                            <td><span class="badge bg-secondary">@ticket.Category</span></td>
                            <td>
                                <span class="badge @GetPriorityBadge(ticket.Priority)">
                                    @ticket.Priority
                                </span>
                            </td>
                            <td>
                                <span class="badge @GetStatusBadge(ticket.Status)">
                                    @ticket.Status
                                </span>
                            </td>
                            <td>
                                <small>@ticket.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<SupportTicketDto> _tickets = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTickets();
    }

    private async Task LoadTickets()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _tickets = await ApiClient.GetTicketsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load tickets: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string GetPriorityBadge(string priority) => priority switch
    {
        "Critical" => "bg-danger",
        "High" => "bg-warning text-dark",
        "Medium" => "bg-info text-dark",
        "Low" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetStatusBadge(string status) => status switch
    {
        "Open" => "bg-primary",
        "InProgress" => "bg-warning text-dark",
        "WaitingOnCustomer" => "bg-info text-dark",
        "Resolved" => "bg-success",
        "Closed" => "bg-secondary",
        _ => "bg-secondary"
    };
}
