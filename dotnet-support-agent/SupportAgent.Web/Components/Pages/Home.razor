@page "/"

<PageTitle>Support Agent - Home</PageTitle>

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">Aspire Support Agent</h1>
        <p class="lead text-muted">Powered by .NET 10 Aspire &amp; Microsoft Agent Framework</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <span class="bi bi-chat-dots-fill display-4 text-primary"></span>
                    <h3 class="card-title mt-3">Chat with Support</h3>
                    <p class="card-text">Get instant help from our AI-powered support agent. Ask questions, troubleshoot issues, or create support tickets.</p>
                    <a href="/chat" class="btn btn-primary btn-lg">Start Chat</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <span class="bi bi-ticket-detailed-fill display-4 text-success"></span>
                    <h3 class="card-title mt-3">View Tickets</h3>
                    <p class="card-text">Track and manage your support tickets. View status, priority, and history of all your support requests.</p>
                    <a href="/tickets" class="btn btn-success btn-lg">View Tickets</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card border-0">
                <div class="card-body text-center">
                    <h5 class="text-primary">AI-Powered</h5>
                    <p class="text-muted small">Uses Microsoft Semantic Kernel Agent Framework for intelligent responses</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0">
                <div class="card-body text-center">
                    <h5 class="text-primary">Knowledge Base</h5>
                    <p class="text-muted small">Built-in knowledge base for instant answers to common questions</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0">
                <div class="card-body text-center">
                    <h5 class="text-primary">Ticket Management</h5>
                    <p class="text-muted small">Create, track, and manage support tickets seamlessly</p>
                </div>
            </div>
        </div>
    </div>
</div>
